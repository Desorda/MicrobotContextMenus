    <Frame name="SetPercentageFrame" parent="UIParent" movable="true" frameStrata="LOW" enableMouse="true">
        <Size>
            <AbsDimension x="215" y="60" />
        </Size>
        <Anchors>
            <Anchor point="CENTER" />
        </Anchors>


        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="12" right="12" top="12" bottom="12" />
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32" />
            </TileSize>
            <EdgeSize>
                <AbsValue val="40" />
            </EdgeSize>
            <Color r="0" g="0" b="0" a="1" />
        </Backdrop>
        <Scripts>
            <OnLoad>
               this:Hide();                
            </OnLoad>
            <OnDragStart>
                this:StartMoving();
            </OnDragStart>
            <OnDragStop>
                this:StopMovingOrSizing();
            </OnDragStop>
        </Scripts>
        <Frames>


            <EditBox name="SetDrinkEatEditBox" letters="3" frameStrata="LOW">
                <Size>
                    <AbsDimension x="205" y="32" />
                </Size>
                <Anchors>
                    <Anchor point="TOP">
                        <Offset>
                            <AbsDimension x="0" y="-5" />
                        </Offset>
                    </Anchor>
                </Anchors>
                <TextInsets>
                    <AbsInset left="10"/>
                </TextInsets>
                <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
                    <BackgroundInsets>
                        <AbsInset left="4" right="4" top="4" bottom="4" />
                    </BackgroundInsets>
                    <EdgeSize>
                        <AbsValue val="20" />
                    </EdgeSize>
                    <Color r="0" g="0" b="0" a="0" />
                </Backdrop>
                <Insets>
                    <AbsInset left="15" right="5" top="2" bottom="2" />
                </Insets>
                <Scripts>
                    <OnLoad>
                        SetDrinkEatEditBox:SetAutoFocus(false);
                    </OnLoad>
                    <OnEnter>
                        GameTooltip:SetOwner(this, "ANCHOR_BOTTOMLEFT");
						GameTooltip:SetText("Enter Value Between 1 and 100");
						GameTooltip:Show();
                    </OnEnter>
                    <OnLeave>
                        GameTooltip:Hide();
                    </OnLeave>
                    <OnEnterPressed>
                        local command = SetDrinkEatEditBox:GetText();
                        SetDrinkEatEditBox:ClearFocus()
                    </OnEnterPressed>
                    <OnEscapePressed>
                        SetDrinkEatEditBox:ClearFocus()
                    </OnEscapePressed>
                </Scripts>
                <FontString inherits="ChatFontNormal" />
            </EditBox>

            <Button name="OkayButton" inherits="UIPanelButtonTemplate" text="Okay" >
				<Size x="75" y="25" />
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="-45" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						confirmSetPercentageFrame();
					</OnClick>
				</Scripts>
			</Button>

            <Button name="CloseButton" inherits="UIPanelButtonTemplate" text="Close">
				<Size x="75" y="25" />
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="45" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						closeSetPercentageFrame();
					</OnClick>
				</Scripts>
			</Button>

        </Frames>

    </Frame>
	
